[Unit]
Description=Kid Portal LAN admin service
After=network-online.target kid-portal.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/opt/kid-portal
Environment=KID_PORTAL_CONFIG=/etc/kid-portal/config.json
Environment=KID_PORTAL_SURFACE=admin
EnvironmentFile=-/etc/kid-portal/youtube.env
RuntimeDirectory=kid-portal
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/opt/kid-portal/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
