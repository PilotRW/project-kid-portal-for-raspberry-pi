[Unit]
Description=Kid Portal Chromium kiosk
After=kid-portal.service kid-portal-x.service
Requires=kid-portal.service kid-portal-x.service

[Service]
User=pi
Environment=DISPLAY=:0
Environment=HOME=/home/pi
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/sbin/kid-portal-launch-chromium
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
